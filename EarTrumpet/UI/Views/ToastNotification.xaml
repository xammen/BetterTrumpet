<Window x:Class="EarTrumpet.UI.Views.ToastNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ToastNotification"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">

    <Border x:Name="ToastBorder"
            Background="#E6111111"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16,14"
            Margin="0"
            RenderTransformOrigin="0.5,1">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="18" ShadowDepth="4" Direction="270"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="TranslateTransform" Y="0"/>
            </TransformGroup>
        </Border.RenderTransform>

        <StackPanel Orientation="Horizontal">
            <Border Background="#1AFFFFFF"
                    CornerRadius="6"
                    Padding="8"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center">
                <TextBlock x:Name="IconText"
                           FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                           FontSize="16"
                           Foreground="#E6FFFFFF"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center" MaxWidth="300">
                <TextBlock x:Name="TitleText"
                           FontSize="12"
                           Foreground="#99FFFFFF"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,2"/>
                <TextBlock x:Name="MessageText"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#F2FFFFFF"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
